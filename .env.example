# Public origin of the production site, without trailing slash. Used for
# canonical URLs, hreflang, Open Graph, structured data, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.example.com

# EmailJS (contact form). These are *public* identifiers by design: they end
# up in the browser bundle. Restrict the allowed origins in the EmailJS
# dashboard (Account → Security) to your domain.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
